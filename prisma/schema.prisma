generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// All money fields are INTEGER MINOR UNITS (øre/cents) in the SHOP'S OWN currency.
// Conversion to USD happens at read time only — never stored converted.

model Shop {
  id         String   @id @default(cuid())
  name       String
  currency   String   // "NOK" | "SEK" | "DKK" | "EUR" | "USD"
  wooUrl     String?
  wooKey     String?
  wooSecret  String?
  // Signs incoming webhook deliveries; generated by us, registered on the
  // store's webhooks, stored encrypted like the API keys.
  wooWebhookSecret String?
  active     Boolean  @default(true)
  // How far through this store's change stream we have read.
  lastSyncAt DateTime?
  // When we last gave this store attention, successful or not. Ordering the
  // sync by this is what stops a slow or broken store from starving the rest.
  lastRunAt  DateTime?
  // Why the last attempt failed; null when it succeeded. Without this a frozen
  // store shows a stale date and no reason at all.
  lastError  String?
  createdAt  DateTime @default(now())

  // Per-shop standards and formats; null falls back to the workspace Setting.
  timezone       String?
  defaultPreset  String?
  dateFormat     String?
  currencyFormat String?
  formatCountry  String?

  orders           Order[]
  products         Product[]
  expenses         OperationalExpense[]
  codes            AmbassadorCode[]
  fulfillmentRates FulfillmentRate[]
  adAccounts       AdAccount[]
  b2bCustomers     B2bCustomer[]
}

model Product {
  id           String   @id @default(cuid())
  shopId       String
  externalId   String   // WooCommerce product id
  sku          String
  name         String
  imageUrl     String?  // product photo, from WooCommerce
  lastPrice    Int      @default(0) // last seen selling price from order lines, minor units, ex VAT
  catalogPrice Int?     // the store's own listed price, minor units, incl VAT

  shop  Shop          @relation(fields: [shopId], references: [id], onDelete: Cascade)
  costs ProductCost[]
  items OrderItem[]
  b2bPrices B2bPrice[]

  @@unique([shopId, externalId])
}

// A product's cost is a TIMELINE, not a single number.
// The cost of an order line is the row with the latest effectiveFrom <= order date.
model ProductCost {
  id            String   @id @default(cuid())
  productId     String
  costPerItem   Int      @default(0) // minor units, shop currency
  handlingCost  Int      @default(0) // minor units, shop currency
  effectiveFrom DateTime
  createdAt     DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, effectiveFrom])
}

model Order {
  id              String   @id @default(cuid())
  shopId          String
  externalId      String   // WooCommerce order id
  number          String
  placedAt        DateTime
  status          String   // "completed" | "processing" | "refunded" | "cancelled" | ...
  currency        String   // shop's currency at time of order

  grossSales      Int      // line value BEFORE discount, excl VAT
  discountTotal   Int      // excl VAT
  netSales        Int      // grossSales - discountTotal. THE COMMISSION BASE. Stored for audit.
  shippingCharged Int      // excl VAT
  taxTotal        Int      // VAT — recorded, never counted as revenue
  total           Int      // what the customer actually paid, incl VAT

  couponCode      String?
  ambassadorId    String?  // resolved AT SYNC TIME and frozen — changing codes never rewrites history
  // Set = this order was entered by hand for a business customer. It is the
  // B2B marker, and the reason the order pays no gateway fee.
  b2bCustomerId   String?
  // What shipping this order actually cost us, in the SHOP's currency (the
  // same frame as FulfillmentRate.perOrder). null = a webshop order, which
  // uses the shop's standing rate instead.
  fulfillmentCost Int?

  // When this order entered a refunded or cancelled state, so the reversal can
  // land on the day the money actually went back rather than silently rewriting
  // the day it was placed. Stamped ONLY on a live -> voided transition: an
  // order that arrives already refunded gets null, because we genuinely do not
  // know when it happened and a guessed date in a profit figure is worse than
  // an honest gap. Null therefore means "never voided, or voided before we
  // started recording" — and such an order contributes nothing, anywhere.
  voidedAt DateTime?

  // Who bought, from Woo's billing details. null = synced before we stored
  // customers (backfill pending); '' = checked, the store has none on file.
  customerName    String?
  customerEmail   String?

  shop       Shop        @relation(fields: [shopId], references: [id], onDelete: Cascade)
  ambassador Ambassador? @relation(fields: [ambassadorId], references: [id], onDelete: SetNull)
  b2bCustomer B2bCustomer? @relation(fields: [b2bCustomerId], references: [id], onDelete: Restrict)
  items      OrderItem[]

  @@unique([shopId, externalId])
  @@index([shopId, placedAt])
  @@index([ambassadorId, placedAt])
  @@index([b2bCustomerId])
}

model OrderItem {
  id           String @id @default(cuid())
  orderId      String
  productId    String
  sku          String
  name         String
  quantity     Int
  unitPrice    Int    // minor units, excl VAT
  lineNetTotal Int    // after discount, excl VAT
  // What was typed on the B2B order form, kept so re-opening it shows "10%"
  // rather than the amount it worked out to. null on every webshop order.
  discountValue Int?    // 10 (percent) or 2000 (minor units per unit)
  discountKind  String? // "PERCENT" | "AMOUNT"

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model OperationalExpense {
  id         String    @id @default(cuid())
  shopId     String
  label      String
  category   String    // "Overhead > Employees", "Fulfillment > Warehouse", ...
  amount     Int       // minor units, in `currency`
  currency   String
  recurrence String    // "ONE_TIME" | "DAILY" | "WEEKLY" | "MONTHLY" | "YEARLY"
  startDate  DateTime  // first payment
  endDate    DateTime?
  active     Boolean   @default(true)
  createdAt  DateTime  @default(now())

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId, startDate])
}

model Ambassador {
  id             String   @id @default(cuid())
  name           String
  email          String   @unique
  commissionRate Float    @default(0.10) // 10%
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  codes    AmbassadorCode[]
  orders   Order[]
  user     User?
  products AmbassadorProduct[]
}

// A discount code belongs to ONE store. The same text may exist on other stores
// meaning something different (a Swedish JOHN10 and a Norwegian JOHN10 are two
// separate codes), so an order only ever matches a code from its own store.
model AmbassadorCode {
  id           String @id @default(cuid())
  ambassadorId String
  shopId       String // the store this code lives on
  code         String // stored UPPERCASE; matching is case-insensitive

  ambassador Ambassador @relation(fields: [ambassadorId], references: [id], onDelete: Cascade)
  shop       Shop       @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, code])
}

model User {
  id           String  @id @default(cuid())
  email        String  @unique
  passwordHash String
  role         String  // "ADMIN" | "AMBASSADOR"
  ambassadorId String? @unique

  ambassador Ambassador? @relation(fields: [ambassadorId], references: [id], onDelete: Cascade)
}

// One row per shop rate change: the fulfillment cost charged to an order is the
// newest rate with effectiveFrom <= the order's date (same idea as ProductCost).
model FulfillmentRate {
  id            String   @id @default(cuid())
  shopId        String
  perOrder      Int      // minor units, shop currency
  effectiveFrom DateTime
  createdAt     DateTime @default(now())

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId, effectiveFrom])
}

// Per-gateway fee rates. Orders are charged the fee of the gateway the stores
// actually route through (Dintero Checkout); other rows are stored settings.
model ProcessingFee {
  id                 String  @id @default(cuid())
  gateway            String  @unique @default("Dintero Checkout")
  percent            Float   // 0.6 means 0.6%
  fixedMinor         Int     // minor units of `currency`
  currency           String  @default("EUR")
  noFeesApply        Boolean @default(false)
  crossBorderPercent Float?  // extra % on cross-border transactions
  active             Boolean @default(true)
}

// Workspace-wide preferences. Exactly one row, id "singleton".
model Setting {
  id             String @id @default("singleton")
  timezone       String @default("Europe/Oslo")
  defaultPreset  String @default("this_month")
  dateFormat     String @default("MMM-dd-yyyy")
  currencyFormat String @default("symbol-after") // symbol-after | code-after | symbol-before
}

model FxRate {
  id    String   @id @default(cuid())
  date  DateTime // the day this rate applies to (UTC midnight)
  base  String   // e.g. "NOK"
  quote String   // e.g. "USD"
  rate  Float    // 1 base = `rate` quote

  @@unique([date, base, quote])
  @@index([base, quote, date])
}

// The client's own Meta and Google apps, entered once in settings. They are
// what make "Connect with Facebook" and "Connect with Google" possible
// without pasting tokens. Standard Access covers reading the client's own ad
// accounts, so neither app needs review.
model AdPlatformApp {
  id             String   @id @default(cuid())
  provider       String   @unique // "meta" | "google"
  clientId       String   // Meta App ID / Google client ID
  clientSecret   String   // encrypted
  developerToken String?  // Google only, encrypted
  createdAt      DateTime @default(now())
}

// One way in — a Facebook or Google login someone completed.
// Many ad accounts can hang off it.
model AdConnection {
  id        String      @id @default(cuid())
  provider  String      // "meta" | "google"
  label     String      // who it belongs to, from the platform
  secret    String      // encrypted: Meta user token / Google refresh token
  // A Meta user token lasts about 60 days and says so. A Google refresh
  // token does not expire while the client stays published, so it is null.
  expiresAt DateTime?
  createdAt DateTime    @default(now())

  accounts AdAccount[]
}

// One connected ad platform account, mapped to the shop it advertises for.
// That mapping is what makes per-shop ROAS possible. Credentials come from its
// connection when it has one; the manual paste path fills `credentials` instead.
model AdAccount {
  id              String    @id @default(cuid())
  shopId          String
  provider        String    // "meta" | "google"
  externalId      String    // Meta: ad account id digits (no act_); Google: customer id (no dashes)
  name            String    // from the platform at connect time, never typed by hand
  currency        String    // from the platform at connect time
  credentials     String?   // encrypted JSON, provider-specific shape (manual path)
  connectionId    String?
  loginCustomerId String?   // Google: the manager (MCC) id access goes through
  dailyBudget     Int?      // current daily budget across active campaigns, minor units, account currency
  active          Boolean   @default(true)
  lastSyncAt      DateTime?
  lastError       String?
  createdAt       DateTime  @default(now())

  shop       Shop          @relation(fields: [shopId], references: [id], onDelete: Cascade)
  connection AdConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  spend      AdSpend[]

  @@unique([provider, externalId])
  @@index([shopId])
}

// One day of one account's delivery. Money in minor units of the ACCOUNT's
// currency; conversion happens at read time like everything else. Only
// day-additive numbers live here — reach/frequency do not sum across days.
model AdSpend {
  id              String   @id @default(cuid())
  accountId       String
  date            DateTime // UTC midnight
  spend           Int
  impressions     Int
  clicks          Int
  linkClicks      Int      @default(0)
  conversions     Float    @default(0) // purchases; Google reports fractions
  conversionValue Int      @default(0) // attributed purchase value, minor units
  videoViews3s    Int      @default(0)
  thruplays       Int      @default(0)
  reach           Int      @default(0)

  account AdAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, date])
  @@index([date])
}

// What we sent an ambassador: a chair, a massage gun, whatever they were given
// to promote. Keyed on SKU, not a Product id, because Product is shop-scoped
// and cascades away with its shop — a gift is a fact about a physical object
// and must outlive a store being removed. `name` is a snapshot for the same
// reason OrderItem.name is one: a shop renaming its listing must not rewrite
// what we already handed over.
//
// No unique on (ambassadorId, sku): two chairs on two dates are two rows, each
// with its own date and note. Collapsing them would lose the second of both.
model AmbassadorProduct {
  id           String   @id @default(cuid())
  ambassadorId String
  sku          String   // product identity ACROSS shops
  name         String   // snapshot at gifting time
  quantity     Int      @default(1)
  receivedAt   DateTime
  note         String?
  createdAt    DateTime @default(now())

  ambassador Ambassador @relation(fields: [ambassadorId], references: [id], onDelete: Cascade)

  @@index([ambassadorId])
  @@index([sku])
}

// A business customer who buys off the webshop. Their orders are ordinary
// Order rows — what makes them different is an agreed price list, their own
// currency, and an invoice instead of a card.
model B2bCustomer {
  id         String   @id @default(cuid())
  shopId     String
  name       String
  currency   String   // what they pay in; need not be the shop's
  vatPercent Float    @default(0) // 25 domestic, 0 reverse-charge or export
  email      String?
  note       String?
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())

  shop   Shop        @relation(fields: [shopId], references: [id], onDelete: Cascade)
  prices B2bPrice[]
  orders Order[]

  @@unique([shopId, name])
}

// This customer's agreed price for one product, in the CUSTOMER'S currency,
// excluding VAT. Deliberately NOT a timeline like ProductCost: it only ever
// pre-fills the order form, and the price actually charged is frozen on the
// OrderItem, so renegotiating a price can never rewrite a past order.
model B2bPrice {
  id         String @id @default(cuid())
  customerId String
  productId  String
  unitPrice  Int    // minor units, customer currency, ex VAT

  customer B2bCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product  Product     @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([customerId, productId])
}
